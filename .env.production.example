# =============================================================================
# InboxIQ — Production Environment Configuration Template
# =============================================================================
# Copy this file to .env on your production server (e.g. VPS / Cloud)
# Replace all placeholder values with your real production secrets.
# NEVER commit .env to public version control repositories!
# =============================================================================

# ---------------------------------------------------------------------------
# Application Settings
# ---------------------------------------------------------------------------
APP_NAME="InboxIQ"
APP_VERSION="1.0.0"
DEBUG=false

# ---------------------------------------------------------------------------
# Security Secrets — Generate long random keys:
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
# ---------------------------------------------------------------------------
SECRET_KEY=CHANGE_THIS_TO_A_64_CHAR_HEX_STRING_FOR_JWT_SIGNING
ENCRYPTION_KEY=CHANGE_THIS_TO_A_64_CHAR_HEX_STRING_FOR_DATABASE_TOKEN_ENCRYPTION

# JWT Settings
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------------------------------------------------------------------------
# Production URLs & Domains
# ---------------------------------------------------------------------------
FRONTEND_URL=https://inboxiq.yourdomain.com
ALLOWED_ORIGINS=https://inboxiq.yourdomain.com

# ---------------------------------------------------------------------------
# Database — PostgreSQL (Containerized or Managed like Supabase/RDS)
# ---------------------------------------------------------------------------
POSTGRES_DB=inboxiq
POSTGRES_USER=inboxiq_admin
POSTGRES_PASSWORD=GENERATE_A_STRONG_DB_PASSWORD_HERE

# ---------------------------------------------------------------------------
# Redis Cache & Broker (Containerized or Upstash)
# ---------------------------------------------------------------------------
REDIS_PASSWORD=GENERATE_A_STRONG_REDIS_PASSWORD_HERE

# ---------------------------------------------------------------------------
# Google OAuth 2.0 Credentials (from Google Cloud Console)
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://inboxiq.yourdomain.com/api/v1/oauth/callback
GMAIL_LABEL=InboxIQ

# ---------------------------------------------------------------------------
# Groq AI API Key (from console.groq.com)
# ---------------------------------------------------------------------------
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ---------------------------------------------------------------------------
# Storage & Limits
# ---------------------------------------------------------------------------
MAX_ATTACHMENT_SIZE_MB=100
RATE_LIMIT_PER_MINUTE=60
