# =============================================================================
# Abhinav Group — AI Gmail Intelligence Assistant
# .gitignore
# =============================================================================

# Environment files — NEVER commit these
.env
.env.local
.env.production
.env.*.local
director-setup/env.director

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
backend/dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/
ENV/

# Node.js / React
frontend/node_modules/
# NOTE: frontend/dist/ is intentionally COMMITTED so the app runs on the
# director's PC after a plain `git clone` (no Node.js build needed).
frontend/build/
frontend/.next/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Uploads & Storage
backend/uploads/
uploads/

# Logs
*.log
logs/
backend/logs/

# Database
*.db
*.sqlite
*.sqlite3

# Docker volumes
postgres_data/
redis_data/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Celery
celerybeat-schedule
celerybeat.pid

# Alembic
# Keep migrations, but not compiled versions

# SSL certificates
*.pem
*.key
*.crt
*.csr

# Test artifacts
.pytest_cache/
test-results/
coverage.xml

# Temporary files
tmp/
temp/
*.tmp
*.bak
*.orig

# FastEmbed local model cache
backend/.fastembed_cache/
.fastembed_cache/

