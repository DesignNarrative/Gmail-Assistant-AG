# =============================================================================
# Abhinav Group — AI Gmail Intelligence Assistant
# Environment Variables Configuration
# =============================================================================
# Copy this file to .env and fill in all values
# NEVER commit .env to version control
# =============================================================================

# ---------------------------------------------------------------------------
# Application Settings
# ---------------------------------------------------------------------------
APP_NAME="Abhinav Group AI Intelligence Assistant"
APP_VERSION="1.0.0"
DEBUG=false

# ---------------------------------------------------------------------------
# Security — CRITICAL: Change this to a long random string in production
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
# ---------------------------------------------------------------------------
SECRET_KEY=CHANGE_THIS_TO_A_VERY_LONG_RANDOM_SECRET_KEY_MINIMUM_64_CHARACTERS

# JWT Settings
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------------------------------------------------------------------------
# Database — PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_DB=abhinav_ai
POSTGRES_USER=abhinav_admin
POSTGRES_PASSWORD=CHANGE_THIS_TO_A_STRONG_DATABASE_PASSWORD

# Full connection URL (constructed from above, or override directly)
DATABASE_URL=postgresql+asyncpg://abhinav_admin:CHANGE_THIS_TO_A_STRONG_DATABASE_PASSWORD@localhost:5432/abhinav_ai

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_PASSWORD=CHANGE_THIS_TO_A_STRONG_REDIS_PASSWORD
REDIS_URL=redis://:CHANGE_THIS_TO_A_STRONG_REDIS_PASSWORD@localhost:6379/0

# ---------------------------------------------------------------------------
# Celery Workers
# ---------------------------------------------------------------------------
CELERY_BROKER_URL=redis://:CHANGE_THIS_TO_A_STRONG_REDIS_PASSWORD@localhost:6379/1
CELERY_RESULT_BACKEND=redis://:CHANGE_THIS_TO_A_STRONG_REDIS_PASSWORD@localhost:6379/2

# ---------------------------------------------------------------------------
# Flower (Celery Monitoring) — Development only
# ---------------------------------------------------------------------------
FLOWER_USER=admin
FLOWER_PASSWORD=CHANGE_THIS_TO_FLOWER_PASSWORD

# ---------------------------------------------------------------------------
# Google OAuth — Fill these in after creating GCP credentials
# Instructions will be provided by the setup guide
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/oauth/callback

# ---------------------------------------------------------------------------
# Gmail Configuration
# ---------------------------------------------------------------------------
# The exact label name in Gmail that emails must have to be synced
GMAIL_LABEL=Director's AI Assistant

# ---------------------------------------------------------------------------
# Groq AI — Fill in after creating Groq account
# Get your free API key at: https://console.groq.com
# ---------------------------------------------------------------------------
GROQ_API_KEY=

# AI Model to use (change to switch providers in future)
AI_PROVIDER=groq
AI_MODEL=llama-3.1-70b-versatile

# ---------------------------------------------------------------------------
# File Storage
# ---------------------------------------------------------------------------
# Max attachment size in MB (100MB recommended for enterprise)
MAX_ATTACHMENT_SIZE_MB=100

# Local upload directory (inside container)
UPLOAD_DIR=./uploads

# ---------------------------------------------------------------------------
# CORS — Allowed frontend origins
# ---------------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Rate Limiting
# ---------------------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=60
LOGIN_RATE_LIMIT_PER_MINUTE=10

# ---------------------------------------------------------------------------
# Bootstrap — First Director Account
# Set this to auto-create the first director account on startup
# ---------------------------------------------------------------------------
FIRST_DIRECTOR_EMAIL=
FIRST_DIRECTOR_NAME=
FIRST_DIRECTOR_PASSWORD=

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log

# ---------------------------------------------------------------------------
# Future — Embedding Model
# ---------------------------------------------------------------------------
EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2
EMBEDDING_DIMENSION=768
